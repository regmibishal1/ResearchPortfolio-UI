{
	"name": "research-portfolio-ui",
	"version": "1.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "node scripts/generate-image-sizes.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-feed.mjs && NG_BUILD_MAX_WORKERS=1 node scripts/build-app.mjs && node scripts/finalize-static.mjs && node scripts/generate-resume-pdf.mjs && node scripts/build-search.mjs",
		"build:cf": "sed -i \"s|%%API_URL%%|${API_URL:-}|g\" src/environments/environment.prod.ts && sed -i \"s|%%MODEL_API_URL%%|${MODEL_API_URL:-}|g\" src/environments/environment.prod.ts && sed -i \"s|%%APP_URL%%|${APP_URL:-}|g\" src/environments/environment.prod.ts && sed -i \"s|%%FASTAPI_API_KEY%%|${FASTAPI_API_KEY:-}|g\" src/environments/environment.prod.ts && sed -i \"s|%%TURNSTILE_SITE_KEY%%|${TURNSTILE_SITE_KEY:-}|g\" src/environments/environment.prod.ts && yarn build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"test-cli": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
		"lint": "ng lint && yarn run pretty",
		"lint:styles": "stylelint \"src/**/*.scss\" && node scripts/check-css-vars.mjs",
		"check:pages": "node scripts/check-pages.mjs",
		"check:a11y": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/check-a11y.mjs",
		"playwright:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium-headless-shell",
		"api:types": "openapi-typescript src/app/api/fastapi-openapi.json -o src/app/api/fastapi-schema.ts",
		"prepare": "husky || true",
		"pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\""
	},
	"private": true,
	"packageManager": "yarn@4.14.1",
	"dependencies": {
		"@angular/cdk": "^22.2.3",
		"@angular/common": "^22.2.3",
		"@angular/compiler": "^22.2.3",
		"@angular/core": "^22.2.3",
		"@angular/forms": "^22.2.3",
		"@angular/material": "^22.2.3",
		"@angular/platform-browser": "^22.2.3",
		"@angular/platform-server": "22.2.3",
		"@angular/router": "^22.2.3",
		"@angular/ssr": "22.2.3",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/outfit": "5.3.0",
		"chart.js": "^4.5.1",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1",
		"zone.js": "~0.16.3"
	},
	"devDependencies": {
		"@angular/build": "22.2.3",
		"@angular/cli": "^22.2.3",
		"@angular/compiler-cli": "^22.2.3",
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@lhci/cli": "0.15.1",
		"@types/jasmine": "~5.1.15",
		"@types/node": "22.20.5",
		"angular-eslint": "22.6.0",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"husky": "^9.1.7",
		"jasmine-core": "~5.13.0",
		"karma": "~6.4.4",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.3.0",
		"lint-staged": "^17.6.0",
		"openapi-typescript": "7.13.0",
		"pagefind": "1.5.2",
		"pdfkit": "0.20.2",
		"playwright": "1.64.1",
		"postcss-scss": "4.0.9",
		"prettier": "^3.9.10",
		"sharp": "0.35.5",
		"stylelint": "17.16.0",
		"stylelint-declaration-strict-value": "1.12.1",
		"subset-font": "2.9.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "8.71.2"
	},
	"resolutions": {
		"tmp": "0.2.7"
	}
}
