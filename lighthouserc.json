{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.mjs dist/research-portfolio-ui/browser 4320",
      "startServerReadyPattern": "serve-static:",
      "url": [
        "http://localhost:4320/",
        "http://localhost:4320/project/mri-classification",
        "http://localhost:4320/blog/will-it-snow-tomorrow"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-byte-weight": ["error", { "maxNumericValue": 650000 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
